# Optional fragment for the experimental -display[-k6s].dtb variants.
# Merge on top of moonstone_defconfig, then run olddefconfig.
# DRM_MSM cannot be built in when these optional dependencies are modules.
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_OCMEM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_KMS=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_DRM_PANEL_XIAOMI_M17=y
CONFIG_REGULATOR_QCOM_REFGEN=y
CONFIG_SM_DISPCC_6375=y
