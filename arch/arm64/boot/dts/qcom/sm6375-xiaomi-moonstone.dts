/dts-v1/;

#include "sm6375.dtsi"
#include "pm6125.dtsi"
#include "pmk8350.dtsi"
#include "pmr735a.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/{
	model = "Xiaomi Poco X5 5G";
	compatible = "xiaomi,moonstone", "qcom,sm6375";
	chassis-type = "handset";
	
	chosen {
		stdout-path = "serial0:115200n8";

		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		framebuffer: framebuffer@85200000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0x85200000 0x0 0xc00000>;
			memory-region = <&cont_splash_mem>;
			width = <1080>;
			height = <2400>;
			stride = <(1080 * 4)>;
			format = "a8r8g8b8";
			clocks = <&gcc GCC_DISP_AHB_CLK>,
				<&gcc GCC_DISP_HF_AXI_CLK>,
				<&gcc GCC_DISP_THROTTLE_CORE_CLK>,
				<&gcc GCC_DISP_GPLL0_DIV_CLK_SRC>;
		};
	};

	aliases {
		serial0 = &uart9;
	};

	gpio-keys {
		compatible = "gpio-keys";
		label = "gpio-keys";

		pinctrl-0 = <&vol_up_n>;
		pinctrl-names = "default";

		key-volume-up {
			label = "Volume Up";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&pmr735a_gpios 1 GPIO_ACTIVE_LOW>;
			debounce-interval = <15>;
			linux,can-disable;
			wakeup-source;
		};
	};
	reserved-memory{
		cont_splash_mem: memory@85200000 {
            		reg = <0x00 0x85200000 0x00 0xc00000>;
            		no-map;
        	};

		ramoops@d0000000 {
			compatible = "ramoops";
			reg = <0x00 0xd0000000 0x00 0x200000>;
			pmsg-size = <0x100000>;
			console-size = <0x100000>;
		};

		secure_display_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x5c00000>;
		};

		mem_dump_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			size = <0x00 0x800000>;
		};

		linux,cma {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x2000000>;
			linux,cma-default;
		};
	};


  
};

 //reserved-memory overrides
&pil_adsp_mem {
    reg = <0 0x86700000 0 0x2800000>;
};

&pil_cdsp_mem {
    reg = <0 0x88f00000 0 0x1e00000>;
};

&pil_video_mem {
    reg = <0 0x8ad00000 0 0x500000>;
};

&pil_ipa_fw_mem {
    reg = <0 0x8b200000 0 0x10000>;
};

&pil_ipa_gsi_mem {
    reg = <0 0x8b210000 0 0xa000>;
};

&pil_gpu_micro_code_mem {
    reg = <0 0x8b21a000 0 0x2000>;
};

&pil_mpss_wlan_mem {
    reg = <0 0x8b800000 0 0x10000000>;
};

&removed_mem {
    reg = <0 0xc0000000 0 0x5100000>;
};

//PMIC overrides
&pm6125_pon {			//Remove duplicate pon labels from pm6125
    /delete-node/ pwrkey;
    /delete-node/ resin;
};

&pon_pwrkey {
	status = "okay";
};

&pon_resin {
	status = "okay";
	linux,code = <KEY_VOLUMEDOWN>;
};

&pmr735a_gpios {
	vol_up_n: vol-up-n-state {
		pins = "gpio1";
		function = "normal";
		input-enable;
		bias-pull-up;
		power-source = <1>;
	};
};

//OVERRIDES RELATED TO CHOSEN

&qupv3_id_1 {
	status = "okay";
	uart9: serial@4c8c000 {
		compatible = "qcom,geni-uart";
		reg = <0x0 0x04c8c000 0x0 0x4000>;
		interrupts = <GIC_SPI 510 IRQ_TYPE_LEVEL_HIGH>;
		clock-names = "se", "m-ahb", "s-ahb";
		clocks = <&gcc GCC_QUPV3_WRAP1_S3_CLK>,
			<&gcc GCC_QUPV3_WRAP_1_M_AHB_CLK>,
			<&gcc GCC_QUPV3_WRAP_1_S_AHB_CLK>;
		power-domains = <&rpmpd SM6375_VDDCX>;
		operating-points-v2 = <&qup_opp_table>;
		pinctrl-0 = <&qup_uart9_default>;
		pinctrl-names = "default";
		status = "okay";
	};
};

&tlmm {
	qup_uart9_default: qup-uart9-default-state {
		pins = "gpio25", "gpio26";
		function = "qup13_f2";
		drive-strength = <2>;
		bias-disable;
	};
};

&rpm_requests {
	regulators-0 {
		compatible = "qcom,rpm-pm6125-regulators";

		pm6125_l4: l4 {
			regulator-min-microvolt = <1100000>;
			regulator-max-microvolt = <1300000>;
		};

		pm6125_l11: l11 {
			regulator-min-microvolt = <1620000>;
			regulator-max-microvolt = <1980000>;
		};

		pm6125_l12: l12 {
			regulator-min-microvolt = <1620000>;
			regulator-max-microvolt = <2000000>;
			regulator-always-on;
		};

		pm6125_l18: l18 {
			regulator-min-microvolt = <830000>;
			regulator-max-microvolt = <920000>;
		};

		pm6125_l24: l24 {
			regulator-min-microvolt = <2700000>;
			regulator-max-microvolt = <3544000>;
		};
	};
};

&soc {
	ufs_mem_hc: ufshc@4804000 {
		compatible = "qcom,sm6375-ufshc", "qcom,ufshc";
		reg = <0x04804000 0x3000>,
		      <0x04808000 0x8000>,
		      <0x04810000 0x9000>;
		reg-names = "std", "ice", "ice_hwkm";
		interrupts = <GIC_SPI 356 IRQ_TYPE_LEVEL_HIGH>;

		clocks = <&gcc GCC_UFS_PHY_AXI_CLK>,
		         <&gcc GCC_SYS_NOC_UFS_PHY_AXI_CLK>,
		         <&gcc GCC_UFS_PHY_AHB_CLK>,
		         <&gcc GCC_UFS_PHY_UNIPRO_CORE_CLK>,
		         <&gcc GCC_UFS_PHY_ICE_CORE_CLK>,
		         <&rpmcc RPM_SMD_XO_CLK_SRC>,
		         <&gcc GCC_UFS_PHY_TX_SYMBOL_0_CLK>,
		         <&gcc GCC_UFS_PHY_RX_SYMBOL_0_CLK>;
		clock-names = "core_clk",
		              "bus_aggr_clk",
		              "iface_clk",
		              "core_clk_unipro",
		              "core_clk_ice",
		              "ref_clk",
		              "tx_lane0_sync_clk",
		              "rx_lane0_sync_clk";

		freq-table-hz = <50000000 200000000>,
		                <0 0>,
		                <0 0>,
		                <37500000 150000000>,
		                <75000000 300000000>,
		                <0 0>,
		                <0 0>,
		                <0 0>;

		power-domains = <&gcc UFS_PHY_GDSC>;
		resets = <&gcc GCC_UFS_PHY_BCR>;
		reset-names = "rst";
		iommus = <&apps_smmu 0x60 0x0>;

		vcc-supply = <&pm6125_l24>;
		vcc-max-microamp = <600000>;
		vccq2-supply = <&pm6125_l11>;
		vccq2-max-microamp = <600000>;
		vdd-hba-supply = <&pm6125_l18>;

		status = "okay";
	};

	ufs_mem_phy: phy@4807000 {
		compatible = "qcom,sm6375-qmp-ufs-phy";
		reg = <0x04807000 0xddc>;
		reg-names = "serdes";

		clocks = <&rpmcc RPM_SMD_XO_CLK_SRC>,
		         <&gcc GCC_UFS_PHY_PHY_AUX_CLK>,
		         <&gcc GCC_UFS_MEM_CLKREF_CLK>;
		clock-names = "ref_clk_src", "ref_clk", "ref_aux_clk";

		resets = <&ufs_mem_hc 0>;
		reset-names = "ufsphy";

		vdda-phy-supply = <&pm6125_l4>;
		vdda-phy-max-microamp = <85700>;
		vdda-pll-supply = <&pm6125_l12>;
		vdda-pll-max-microamp = <18300>;

		lanes-per-direction = <1>;
		#phy-cells = <0>;

		status = "okay";
	};
};
