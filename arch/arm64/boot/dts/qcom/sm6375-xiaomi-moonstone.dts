/dts-v1/;

/* PMK8350 is configured to use SID6 instead of 0 */
#define PMK8350_SID 6

#include <dt-bindings/gpio/gpio.h>
#include "sm6375.dtsi"
#include "pm6125.dtsi"
#include "pmk8350.dtsi"
#include "pmr735a.dtsi"
#include <dt-bindings/input/input.h>

/* PM6125 PON is used and we can't have duplicate labels */
/delete-node/ &pmk8350_pon;

/ {
	model = "Xiaomi Poco X5 5G";
	compatible = "xiaomi,moonstone", "qcom,sm6375";

	/* Required by Qualcomm ABL to validate the DTB */
	qcom,msm-id = <0x1fb 0x10000 0x242 0x10000>;
	qcom,board-id = <0x1000b 0x00>;

	chassis-type = "handset";

	chosen {
		stdout-path = "serial0:115200n8";

		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		framebuffer: framebuffer@85200000 {
			compatible = "simple-framebuffer";
			reg = <0 0x85200000 0 0xc00000>;

			width = <1080>;
			height = <2400>;
			stride = <(1080 * 4)>;
			format = "a8r8g8b8";
			/*
			 * That's (going to be) a lot of clocks, but it's necessary due
			 * to unused clk cleanup & no panel driver yet
			 */
			clocks = <&gcc GCC_DISP_AHB_CLK>,
				 <&gcc GCC_DISP_HF_AXI_CLK>,
				 <&gcc GCC_DISP_THROTTLE_CORE_CLK>,
				 <&gcc GCC_DISP_GPLL0_DIV_CLK_SRC>;
		};
	};

	aliases {
		serial0 = &uart9;
	};

	gpio-keys {
		compatible = "gpio-keys";
		label = "gpio-keys";

		pinctrl-0 = <&vol_up_n>;
		pinctrl-names = "default";

		key-volume-up {
			label = "Volume Up";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&pmr735a_gpios 1 GPIO_ACTIVE_LOW>;
			debounce-interval = <15>;
			linux,can-disable;
			wakeup-source;
		};
	};

	reserved-memory {
		cont_splash_mem: memory@85200000 {
			reg = <0 0x85200000 0 0xc00000>;
			no-map;
		};

		ramoops@d0000000 {
			compatible = "ramoops";
			reg = <0 0xd0000000 0 0x200000>;
			record-size = <0x40000>;
			console-size = <0x100000>;
			pmsg-size = <0x80000>;
		};
	};

	vph_pwr: vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-min-microvolt = <3700000>;
		regulator-max-microvolt = <3700000>;
		regulator-always-on;
		regulator-boot-on;
	};
	vreg_dummy_1p2vreg_l8a: regulator-dummy-1p2 {
		compatible = "regulator-fixed";
		regulator-name = "vreg_dummy_1p2";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		regulator-always-on;
	};

	vreg_dummy_1p8vreg_l13a: regulator-dummy-1p8 {
		compatible = "regulator-fixed";
		regulator-name = "vreg_dummy_1p8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};
};

/* PIL memory region overrides matching stock Moonstone layout */
&pil_adsp_mem {
	reg = <0 0x86700000 0 0x2800000>;
};

&pil_cdsp_mem {
	reg = <0 0x88f00000 0 0x1e00000>;
};

&pil_video_mem {
	reg = <0 0x8ad00000 0 0x500000>;
};

&pil_ipa_fw_mem {
	reg = <0 0x8b200000 0 0x10000>;
};

&pil_ipa_gsi_mem {
	reg = <0 0x8b210000 0 0xa000>;
};

&pil_gpu_micro_code_mem {
	reg = <0 0x8b21a000 0 0x2000>;
};

&pil_mpss_wlan_mem {
	reg = <0 0x8b800000 0 0x10000000>;
};

&removed_mem {
	reg = <0 0xc0000000 0 0x5100000>;
};

&pon_pwrkey {
	status = "okay";
};

&pon_resin {
	status = "okay";
	linux,code = <KEY_VOLUMEDOWN>;
};

&pmr735a_gpios {
	vol_up_n: vol-up-n-state {
		pins = "gpio1";
		function = "normal";
		input-enable;
		bias-pull-up;
		power-source = <1>;
	};
};

&gpi_dma0 {
	status = "okay";
};

&gpi_dma1 {
	status = "okay";
};

&qupv3_id_0 {
	status = "okay";
};

&qupv3_id_1 {
	status = "okay";

	uart9: serial@4c8c000 {
		compatible = "qcom,geni-uart";
		reg = <0x0 0x04c8c000 0x0 0x4000>;
		interrupts = <GIC_SPI 510 IRQ_TYPE_LEVEL_HIGH>;
		clock-names = "se";
		clocks = <&gcc GCC_QUPV3_WRAP1_S3_CLK>;
		pinctrl-0 = <&qup_uart9_default>;
		pinctrl-names = "default";
		status = "okay";
	};
};

&i2c8 {
	status = "okay";

	touchscreen@38 {
		compatible = "focaltech,ft3519t";
		reg = <0x38>;
		
		interrupt-parent = <&tlmm>;
		interrupts = <22 IRQ_TYPE_EDGE_FALLING>;
		
		reset-gpios = <&tlmm 21 GPIO_ACTIVE_LOW>;
		vcc-supply = <&reg_ts_avdd>;
		iovcc-supply = <&pm6125_l13>; 

		touchscreen-size-x = <1080>;
		touchscreen-size-y = <2400>;
	};
};


&tlmm {
	gpio-reserved-ranges = <13 4>;

	qup_uart9_default: qup-uart9-default-state {
		pins = "gpio25", "gpio26";
		function = "qup13_f2";
		drive-strength = <2>;
		bias-disable;
	};
};

&uart1 {
	status = "okay";
	
	bluetooth {
		compatible = "qcom,wcn6855-bt";
		
		vddio-supply = <&pm6125_l13>; 
		vddaon-supply = <&pm6125_l19>;
		vddrfa1-supply = <&pm6125_l20>;
		vddrfa2-supply = <&pm6125_l20>;
		vddrfa3-supply = <&pm6125_l20>;

		enable-gpios = <&tlmm 85 GPIO_ACTIVE_HIGH>;
		
		max-speed = <3200000>;
	};
};

&remoteproc_adsp {
	firmware-name = "qcom/sm6375/xiaomi/moonstone/adsp.mbn";
	status = "okay";
};

&remoteproc_cdsp {
	firmware-name = "qcom/sm6375/xiaomi/moonstone/cdsp.mbn";
	status = "okay";
};

&remoteproc_mss {
	firmware-name = "qcom/sm6375/xiaomi/moonstone/modem.mbn";
	status = "okay";
};

&rpm_requests {
	regulators-0 {
		compatible = "qcom,rpm-pm6125-regulators";

		pm6125_s5: s5 {
			regulator-min-microvolt = <382000>;
			regulator-max-microvolt = <1120000>;
		};

		pm6125_s6: s6 {
			regulator-min-microvolt = <320000>;
			regulator-max-microvolt = <1374000>;
		};

		pm6125_s7: s7 {
			regulator-min-microvolt = <1574000>;
			regulator-max-microvolt = <2040000>;
		};

		/*
		 * S8 is VDD_GFX
		 * L1 is VDD_LPI_CX
		 */

		pm6125_l2: l2 {
			regulator-min-microvolt = <1170000>;
			regulator-max-microvolt = <1304000>;
		};

		pm6125_l3: l3 {
			regulator-min-microvolt = <1100000>;
			regulator-max-microvolt = <1300000>;
		};

		pm6125_l4: l4 {
			regulator-min-microvolt = <1100000>;
			regulator-max-microvolt = <1300000>;
		};

		pm6125_l5: l5 {
			regulator-min-microvolt = <1650000>;
			regulator-max-microvolt = <2960000>;
			regulator-allow-set-load;
		};

		pm6125_l6: l6 {
			regulator-min-microvolt = <1080000>;
			regulator-max-microvolt = <1304000>;
		};

		pm6125_l7: l7 {
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <880000>;
		};

		pm6125_l8: l8 {
			regulator-min-microvolt = <1100000>;
			regulator-max-microvolt = <1304000>;
		};

		pm6125_l9: l9 {
			regulator-min-microvolt = <1504000>;
			regulator-max-microvolt = <2000000>;
		};

		pm6125_l10: l10 {
			regulator-min-microvolt = <1620000>;
			regulator-max-microvolt = <1980000>;
		};

		pm6125_l11: l11 {
			regulator-min-microvolt = <1620000>;
			regulator-max-microvolt = <1980000>;
		};

		pm6125_l12: l12 {
			regulator-min-microvolt = <1620000>;
			regulator-max-microvolt = <2000000>;
		};

		pm6125_l13: l13 {
			regulator-min-microvolt = <1650000>;
			regulator-max-microvolt = <1980000>;
		};

		pm6125_l14: l14 {
			regulator-min-microvolt = <1700000>;
			regulator-max-microvolt = <1900000>;
		};

		pm6125_l15: l15 {
			regulator-min-microvolt = <1650000>;
			regulator-max-microvolt = <3544000>;
		};

		pm6125_l16: l16 {
			regulator-min-microvolt = <1620000>;
			regulator-max-microvolt = <1980000>;
		};

		/* L17 is VDD_LPI_MX */

		pm6125_l18: l18 {
			regulator-min-microvolt = <830000>;
			regulator-max-microvolt = <920000>;
		};

		pm6125_l19: l19 {
			regulator-min-microvolt = <1624000>;
			regulator-max-microvolt = <3304000>;
		};

		pm6125_l20: l20 {
			regulator-min-microvolt = <1624000>;
			regulator-max-microvolt = <3304000>;
		};

		pm6125_l21: l21 {
			regulator-min-microvolt = <3000000>;
			regulator-max-microvolt = <3312000>;
		};

		pm6125_l22: l22 {
			regulator-min-microvolt = <2704000>;
			regulator-max-microvolt = <2960000>;
			regulator-allow-set-load;
		};

		pm6125_l23: l23 {
			regulator-min-microvolt = <3000000>;
			regulator-max-microvolt = <3312000>;
		};

		pm6125_l24: l24 {
			regulator-min-microvolt = <2704000>;
			regulator-max-microvolt = <3544000>;
		};
	};

	regulators-1 {
		compatible = "qcom,rpm-pmr735a-regulators";

		/*
		 * S1 is VDD_MX
		 * S2 is VDD_CX
		 */

		pmr735a_l1: l1 {
			regulator-min-microvolt = <570000>;
			regulator-max-microvolt = <650000>;
		};

		pmr735a_l2: l2 {
			regulator-min-microvolt = <640000>;
			regulator-max-microvolt = <640000>;
		};

		pmr735a_l3: l3 {
			regulator-min-microvolt = <1000000>;
			regulator-max-microvolt = <1200000>;
		};

		pmr735a_l4: l4 {
			regulator-min-microvolt = <1504000>;
			regulator-max-microvolt = <2000000>;
		};

		pmr735a_l5: l5 {
			regulator-min-microvolt = <751000>;
			regulator-max-microvolt = <824000>;
		};

		pmr735a_l6: l6 {
			regulator-min-microvolt = <504000>;
			regulator-max-microvolt = <868000>;
		};

		pmr735a_l7: l7 {
			regulator-min-microvolt = <2700000>;
			regulator-max-microvolt = <3544000>;
		};
	};
};



&usb_1 {
	status = "okay";
};

&usb_1_dwc3 {
	dr_mode = "peripheral";
};

&usb_1_hsphy {
	vdda-pll-supply = <&pm6125_l7>;
	vdda18-supply = <&pm6125_l10>;
	vdda33-supply = <&pmr735a_l7>;
	status = "okay";
};

&xo_board_clk {
	clock-frequency = <19200000>;
};

&soc {
	ufs_mem_hc: ufshc@4804000 {
		compatible = "qcom,sm6375-ufshc", "qcom,ufshc";
		reg = <0x0 0x04804000 0x0 0x3000>,
		      <0x0 0x04808000 0x0 0x8000>,
		      <0x0 0x04810000 0x0 0x9000>;
		reg-names = "std", "ice", "ice_hwkm";
		interrupts = <GIC_SPI 356 IRQ_TYPE_LEVEL_HIGH>;

		phys = <&ufs_mem_phy>;
		phy-names = "ufsphy";
		#reset-cells = <1>;

		clocks = <&gcc GCC_UFS_PHY_AXI_CLK>,
		         <&gcc GCC_SYS_NOC_UFS_PHY_AXI_CLK>,
		         <&gcc GCC_UFS_PHY_AHB_CLK>,
		         <&gcc GCC_UFS_PHY_UNIPRO_CORE_CLK>,
		         <&gcc GCC_UFS_PHY_ICE_CORE_CLK>,
		         <&rpmcc RPM_SMD_XO_CLK_SRC>,
		         <&gcc GCC_UFS_PHY_TX_SYMBOL_0_CLK>,
		         <&gcc GCC_UFS_PHY_RX_SYMBOL_0_CLK>;
		clock-names = "core_clk",
		              "bus_aggr_clk",
		              "iface_clk",
		              "core_clk_unipro",
		              "core_clk_ice",
		              "ref_clk",
		              "tx_lane0_sync_clk",
		              "rx_lane0_sync_clk";

		freq-table-hz = <50000000 200000000>,
		                <0 0>,
		                <0 0>,
		                <37500000 150000000>,
		                <75000000 300000000>,
		                <0 0>,
		                <0 0>,
		                <0 0>;

		power-domains = <&gcc UFS_PHY_GDSC>;
		resets = <&gcc GCC_UFS_PHY_BCR>;
		reset-names = "rst";
		iommus = <&apps_smmu 0x60 0x0>;

		vcc-supply = <&pm6125_l24>;
		vcc-max-microamp = <600000>;
		vccq2-supply = <&pm6125_l11>;
		vccq2-max-microamp = <600000>;
		vdd-hba-supply = <&pm6125_l18>;

		status = "okay";
	};

	ufs_mem_phy: phy@4807000 {
		compatible = "qcom,sm6375-qmp-ufs-phy";
		reg = <0x0 0x04807000 0x0 0xddc>;
		reg-names = "serdes";

		clocks = <&rpmcc RPM_SMD_XO_CLK_SRC>,
		         <&gcc GCC_UFS_PHY_PHY_AUX_CLK>,
		         <&gcc GCC_UFS_MEM_CLKREF_CLK>;
		clock-names = "ref_clk_src", "ref_clk", "ref_aux_clk";

		resets = <&ufs_mem_hc 0>;
		reset-names = "ufsphy";

		vdda-phy-supply = <&pm6125_l4>;
		vdda-phy-max-microamp = <85700>;
		vdda-pll-supply = <&pm6125_l12>;
		vdda-pll-max-microamp = <18300>;

		lanes-per-direction = <1>;
		#phy-cells = <0>;

		status = "okay";
	};
};

&mdss_dsi0 {
	status = "okay";
	vdda-supply = <&vreg_l6b>;

	panel@0 {
		compatible = "xiaomi,moonstone-m17";
		reg = <0>;

		/* Real PMIC routing extracted from vendor_boot */
		vddio-supply = <&vreg_l13a>;
		vdd-supply = <&vreg_l8a>;
		reset-gpios = <&pmr735a_gpios 2 GPIO_ACTIVE_LOW>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&mdss_dsi0_out>;
			};
		};
	};
};

/* Temporary dummy regulators to satisfy display dependencies during bring-up */
/ {
	vreg_dummy_1p2: regulator-dummy-1p2 {
		compatible = "regulator-fixed";
		regulator-name = "vreg_dummy_1p2";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
	};

	vreg_dummy_1p8: regulator-dummy-1p8 {
		compatible = "regulator-fixed";
		regulator-name = "vreg_dummy_1p8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};
};


/* Temporary dummy regulators to satisfy display dependencies */
/ {
	vreg_l6b: regulator-dummy-l6b {
		compatible = "regulator-fixed";
		regulator-name = "vreg_l6b_dummy";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		regulator-always-on;
	};

	vreg_l13a: regulator-dummy-l13a {
		compatible = "regulator-fixed";
		regulator-name = "vreg_l13a_dummy";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	vreg_l8a: regulator-dummy-l8a {
		compatible = "regulator-fixed";
		regulator-name = "vreg_l8a_dummy";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <3000000>;
		regulator-always-on;
	};
};

/ {
	reg_ts_avdd: ts-avdd-regulator {
		compatible = "regulator-fixed";
		regulator-name = "ts_avdd";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		gpio = <&tlmm 49 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};
};


&mdss_dsi0_out {
	remote-endpoint = <&panel_in>;
	data-lanes = <0 1 2 3>;
};

&spmi_bus {
	pm6125_lsid0: pmic@0 {
		compatible = "qcom,pm6125", "qcom,spmi-pmic";
		reg = <0x0 SPMI_USID>;
		#address-cells = <1>;
		#size-cells = <0>;

		pm6125_pon: pon@800 {
			compatible = "qcom,pm8916-pon";
			reg = <0x800>;
			mode = "hard";
		};
	};
};
