// SPDX-License-Identifier: BSD-3-Clause
/*
 * Device Tree Source for Xiaomi Poco X5 5G (moonstone)
 * Based on SM6375 SoC
 */

/dts-v1/;

#define PMK8350_SID 6

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include "sm6375.dtsi"
#include "pm6125.dtsi"
#include "pmk8350.dtsi"
#include "pmr735a.dtsi"

/ {
	model = "Xiaomi Poco X5 5G";
	compatible = "xiaomi,moonstone", "qcom,sm6375";
	chassis-type = "handset";

	/* 6 GB RAM, starting at 2 GB physical */
	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x1 0x80000000>; /* 6 GB = 0x1_80000000 */
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		stdout-path = "serial0:115200n8";
		bootargs = "console=ttyMSM0,115200n8 earlycon=msm_geni_serial,0x04C8C000";

		framebuffer: framebuffer@85200000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0x85200000 0x0 0xc00000>;
			width = <1080>;
			height = <2400>;
			stride = <(1080 * 4)>;
			format = "a8r8g8b8";
			clocks = <&gcc GCC_DISP_AHB_CLK>,
				 <&gcc GCC_DISP_HF_AXI_CLK>,
				 <&gcc GCC_DISP_THROTTLE_CORE_CLK>,
				 <&gcc GCC_DISP_GPLL0_DIV_CLK_SRC>;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		label = "gpio-keys";

		pinctrl-0 = <&vol_up_n>;
		pinctrl-names = "default";

		key-volume-up {
			label = "Volume Up";
			linux,code = <KEY_VOLUMEUP>;
			gpios = <&pmr735a_gpios 1 GPIO_ACTIVE_LOW>;
			debounce-interval = <15>;
			linux,can-disable;
			wakeup-source;
		};
	};

	vph_pwr: vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-min-microvolt = <3700000>;
		regulator-max-microvolt = <3700000>;
		regulator-always-on;
		regulator-boot-on;
	};
};

/* Override reserved memory regions from sm6375.dtsi with stock firmware addresses */
&hyp_mem {
	reg = <0x0 0x80000000 0x0 0x600000>;
};

&xbl_aop_mem {
	reg = <0x0 0x80700000 0x0 0x100000>;
};

&reserved_xbl_uefi {
	reg = <0x0 0x80880000 0x0 0x14000>;
};

&smem_mem {
	reg = <0x0 0x80900000 0x0 0x200000>;
};

&fw_mem {
	reg = <0x0 0x80b00000 0x0 0x100000>;
};

&cdsp_secure_heap_mem {
	reg = <0x0 0x80c00000 0x0 0x1e00000>;
};

&pil_wlan_mem {
	reg = <0x0 0x86500000 0x0 0x200000>;
};

&pil_adsp_mem {
	reg = <0x0 0x86700000 0x0 0x2800000>;
};

&pil_cdsp_mem {
	reg = <0x0 0x88f00000 0x0 0x1e00000>;
};

&pil_video_mem {
	reg = <0x0 0x8ad00000 0x0 0x500000>;
};

&pil_ipa_fw_mem {
	reg = <0x0 0x8b200000 0x0 0x10000>;
};

&pil_ipa_gsi_mem {
	reg = <0x0 0x8b210000 0x0 0xa000>;
};

&pil_gpu_micro_code_mem {
	reg = <0x0 0x8b21a000 0x0 0x2000>;
};

&pil_mpss_wlan_mem {
	reg = <0x0 0x8b800000 0x0 0x10000000>;
};

&removed_mem {
	reg = <0x0 0xc0000000 0x0 0x5100000>;
};

&dfps_data_mem {
	reg = <0x0 0x85e00000 0x0 0x100000>;
};

/* Add extra reserved memory regions from stock firmware */
&reserved_memory {
	secure_display_memory: secure-display-region {
		compatible = "shared-dma-pool";
		alloc-ranges = <0x0 0x0 0x0 0xffffffff>;
		reusable;
		alignment = <0x0 0x400000>;
		size = <0x0 0x5c00000>;
	};

	mem_dump_region: mem-dump-region {
		compatible = "shared-dma-pool";
		alloc-ranges = <0x0 0x0 0x0 0xffffffff>;
		reusable;
		size = <0x0 0x800000>;
	};

	cont_splash_mem: memory@85200000 {
		reg = <0x0 0x85200000 0x0 0xc00000>;
		no-map;
	};

	ramoops_mem: ramoops@d0000000 {
		compatible = "ramoops";
		reg = <0x0 0xd0000000 0x0 0x200000>;
		pmsg-size = <0x100000>;
		console-size = <0x100000>;
	};

	linux,cma {
		compatible = "shared-dma-pool";
		alloc-ranges = <0x0 0x0 0x0 0xffffffff>;
		reusable;
		alignment = <0x0 0x400000>;
		size = <0x0 0x2000000>;
		linux,cma-default;
	};

	adsp_mem: adsp-region {
		compatible = "shared-dma-pool";
		alloc-ranges = <0x0 0x0 0x0 0xffffffff>;
		reusable;
		alignment = <0x0 0x400000>;
		size = <0x0 0x800000>;
	};

	user_contig_mem: user-contig-region {
		compatible = "shared-dma-pool";
		alloc-ranges = <0x0 0x0 0x0 0xffffffff>;
		reusable;
		alignment = <0x0 0x400000>;
		size = <0x0 0x1000000>;
	};

	qseecom_mem: qseecom-region {
		compatible = "shared-dma-pool";
		alloc-ranges = <0x0 0x0 0x0 0xffffffff>;
		reusable;
		alignment = <0x0 0x400000>;
		size = <0x0 0x1400000>;
	};

	qseecom_ta_mem: qseecom-ta-region {
		compatible = "shared-dma-pool";
		alloc-ranges = <0x0 0x0 0x0 0xffffffff>;
		reusable;
		alignment = <0x0 0x400000>;
		size = <0x0 0x1000000>;
	};

	memshare_mem: memshare-region {
		compatible = "shared-dma-pool";
		no-map;
		alloc-ranges = <0x0 0x0 0x0 0xffffffff>;
		alignment = <0x0 0x100000>;
		size = <0x0 0x800000>;
	};
};

&pm6125_pon {
	/delete-node/ pwrkey;
	/delete-node/ resin;
};

&pon_pwrkey {
	status = "okay";
};

&pon_resin {
	status = "okay";
	linux,code = <KEY_VOLUMEDOWN>;
};

&pmr735a_gpios {
	vol_up_n: vol-up-n-state {
		pins = "gpio1";
		function = "normal";
		input-enable;
		bias-pull-up;
		power-source = <1>;
	};
};

&qupv3_id_1 {
	status = "okay";

	uart9: serial@4c8c000 {
		compatible = "qcom,geni-uart";
		reg = <0x0 0x04c8c000 0x0 0x4000>;
		interrupts = <GIC_SPI 510 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&gcc GCC_QUPV3_WRAP1_S3_CLK>;
		clock-names = "se";
		power-domains = <&rpmpd SM6375_VDDCX>;
		operating-points-v2 = <&qup_opp_table>;
		pinctrl-0 = <&qup_uart9_default>;
		pinctrl-1 = <&qup_uart9_sleep>;
		pinctrl-names = "default", "sleep";
		status = "okay";
	};
};

&gpi_dma1 {
	status = "okay";
};

&tlmm {
	qup_uart9_default: qup-uart9-default-state {
		pins = "gpio25", "gpio26";
		function = "qup13_f2";
		drive-strength = <2>;
		bias-disable;
	};

	qup_uart9_sleep: qup-uart9-sleep-state {
		pins = "gpio25", "gpio26";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	/* Touchscreen */
	ts_int_default: ts-int-default-state {
		pins = "gpio22";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	ts_avdd_default: ts-avdd-default-state {
		pins = "gpio59";
		function = "gpio";
		drive-strength = <8>;
		output-low;
	};

	/* SD card detect */
	sdc2_cd_default: sdc2-cd-default-state {
		pins = "gpio94";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};
};

/* SD card slot */
&sdhc_2 {
	status = "okay";
	pinctrl-0 = <&sdc2_on_state &sdc2_cd_default>;
	pinctrl-1 = <&sdc2_off_state>;
	pinctrl-names = "default", "sleep";
	vmmc-supply = <&pm6125_l22>;
	vqmmc-supply = <&pm6125_l5>;
	cd-gpios = <&tlmm 94 GPIO_ACTIVE_HIGH>;
};

/* PMIC regulators (based on stock firmware voltages) */
&rpm_requests {
	regulators-0 {
		compatible = "qcom,rpm-pm6125-regulators";

		pm6125_s5: s5 {
			regulator-min-microvolt = <382000>;
			regulator-max-microvolt = <1120000>;
		};

		pm6125_s6: s6 {
			regulator-min-microvolt = <320000>;
			regulator-max-microvolt = <1374000>;
		};

		pm6125_s7: s7 {
			regulator-min-microvolt = <1574000>;
			regulator-max-microvolt = <2040000>;
		};

		pm6125_l2: l2 {
			regulator-min-microvolt = <1170000>;
			regulator-max-microvolt = <1304000>;
		};

		pm6125_l3: l3 {
			regulator-min-microvolt = <1100000>;
			regulator-max-microvolt = <1300000>;
		};

		pm6125_l4: l4 {
			regulator-min-microvolt = <1100000>;
			regulator-max-microvolt = <1300000>;
		};

		pm6125_l5: l5 {
			regulator-min-microvolt = <1650000>;
			regulator-max-microvolt = <2960000>;
			regulator-allow-set-load;
		};

		pm6125_l6: l6 {
			regulator-min-microvolt = <1080000>;
			regulator-max-microvolt = <1304000>;
		};

		pm6125_l7: l7 {
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <880000>;
		};

		pm6125_l8: l8 {
			regulator-min-microvolt = <1100000>;
			regulator-max-microvolt = <1304000>;
		};

		pm6125_l9: l9 {
			regulator-min-microvolt = <1504000>;
			regulator-max-microvolt = <2000000>;
		};

		pm6125_l10: l10 {
			regulator-min-microvolt = <1620000>;
			regulator-max-microvolt = <1980000>;
		};

		pm6125_l11: l11 {
			regulator-min-microvolt = <1620000>;
			regulator-max-microvolt = <1980000>;
		};

		pm6125_l12: l12 {
			regulator-min-microvolt = <1620000>;
			regulator-max-microvolt = <2000000>;
		};

		pm6125_l13: l13 {
			regulator-min-microvolt = <1650000>;
			regulator-max-microvolt = <1980000>;
		};

		pm6125_l14: l14 {
			regulator-min-microvolt = <1700000>;
			regulator-max-microvolt = <1900000>;
		};

		pm6125_l15: l15 {
			regulator-min-microvolt = <1650000>;
			regulator-max-microvolt = <3544000>;
		};

		pm6125_l16: l16 {
			regulator-min-microvolt = <1620000>;
			regulator-max-microvolt = <1980000>;
		};

		pm6125_l18: l18 {
			regulator-min-microvolt = <830000>;
			regulator-max-microvolt = <920000>;
		};

		pm6125_l19: l19 {
			regulator-min-microvolt = <1624000>;
			regulator-max-microvolt = <3304000>;
		};

		pm6125_l20: l20 {
			regulator-min-microvolt = <1624000>;
			regulator-max-microvolt = <3304000>;
		};

		pm6125_l21: l21 {
			regulator-min-microvolt = <3000000>;
			regulator-max-microvolt = <3312000>;
		};

		pm6125_l22: l22 {
			regulator-min-microvolt = <2704000>;
			regulator-max-microvolt = <2960000>;
			regulator-allow-set-load;
		};

		pm6125_l23: l23 {
			regulator-min-microvolt = <3000000>;
			regulator-max-microvolt = <3312000>;
		};

		pm6125_l24: l24 {
			regulator-min-microvolt = <2704000>;
			regulator-max-microvolt = <3544000>;
		};
	};

	regulators-1 {
		compatible = "qcom,rpm-pmr735a-regulators";

		pmr735a_l1: l1 {
			regulator-min-microvolt = <570000>;
			regulator-max-microvolt = <650000>;
		};

		pmr735a_l2: l2 {
			regulator-min-microvolt = <640000>;
			regulator-max-microvolt = <640000>;
		};

		pmr735a_l3: l3 {
			regulator-min-microvolt = <1000000>;
			regulator-max-microvolt = <1200000>;
		};

		pmr735a_l4: l4 {
			regulator-min-microvolt = <1504000>;
			regulator-max-microvolt = <2000000>;
		};

		pmr735a_l5: l5 {
			regulator-min-microvolt = <751000>;
			regulator-max-microvolt = <824000>;
		};

		pmr735a_l6: l6 {
			regulator-min-microvolt = <504000>;
			regulator-max-microvolt = <868000>;
		};

		pmr735a_l7: l7 {
			regulator-min-microvolt = <2700000>;
			regulator-max-microvolt = <3544000>;
		};
	};
};

/* I2C8: touchscreen, charger, etc. */
&i2c8 {
	status = "okay";
	clock-frequency = <400000>;

	touchscreen@48 {
		compatible = "focaltech,fts";
		reg = <0x48>;
		interrupt-parent = <&tlmm>;
		interrupts = <22 IRQ_TYPE_EDGE_FALLING>;
		pinctrl-names = "default";
		pinctrl-0 = <&ts_int_default &ts_avdd_default>;
		focaltech,reset-gpio = <&tlmm 21 GPIO_ACTIVE_LOW>;
		focaltech,irq-gpio = <&tlmm 22 IRQ_TYPE_EDGE_FALLING>;
		focaltech,avdd-gpio = <&tlmm 59 GPIO_ACTIVE_HIGH>;
		avdd-supply = <&pm6125_l13>;
		vdd-supply = <&pm6125_l13>;
	};
};

/* Wi-Fi */
&wifi {
	vdd-0.8-cx-mx-supply = <&pmr735a_l2>;
	vdd-1.8-xo-supply = <&pm6125_l16>;
	vdd-1.3-rfa-supply = <&pm6125_l2>;
	vdd-3.3-ch0-supply = <&pm6125_l23>;
	vdd-3.3-ch1-supply = <&pm6125_l21>;
	status = "okay";
};

/* USB */
&usb_1 {
	status = "okay";
};

&usb_1_dwc3 {
	dr_mode = "peripheral";
};

&usb_1_hsphy {
	vdda-pll-supply = <&pm6125_l7>;
	vdda18-supply = <&pm6125_l10>;
	vdda33-supply = <&pmr735a_l7>;
	status = "okay";
};

/* PMIC and thermal monitoring */
&pmk8350_adc_tm {
	status = "okay";
};

&pmk8350_rtc {
	status = "okay";
};

/* Enable ADSP, CDSP, Modem (load firmware from filesystem) */
&remoteproc_adsp {
	firmware-name = "qcom/sm6375/xiaomi/moonstone/adsp.mbn";
	status = "okay";
};

&remoteproc_cdsp {
	firmware-name = "qcom/sm6375/xiaomi/moonstone/cdsp.mbn";
	status = "okay";
};

&remoteproc_mss {
	firmware-name = "qcom/sm6375/xiaomi/moonstone/modem.mbn";
	status = "okay";
};

/* XO clock rate */
&xo_board_clk {
	clock-frequency = <19200000>;
};
